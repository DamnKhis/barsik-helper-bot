# ---------------------------------------------------------------------------
# BARS KB — configuration
# Copy to .env and fill the Qwen API key when it is available.
# Without a key the pipeline automatically falls back to mock/hash mode.
# ---------------------------------------------------------------------------

# All enrichment and vision runs on Qwen3.8-Flash.
# mock | qwen
LLM_PROVIDER=qwen
VISION_PROVIDER=qwen

# Dense vectors use a separate Qwen embedding model:
# Qwen3.8-Flash is a chat/multimodal model and has no embeddings endpoint.
# mock | qwen   (hash fallback when the key is empty)
EMBEDDING_PROVIDER=qwen

QWEN_API_KEY=

# Current access: OpenRouter (one key for chat and embeddings).
QWEN_BASE_URL=https://openrouter.ai/api/v1
QWEN_LLM_MODEL=qwen/qwen3.8-flash
QWEN_VISION_MODEL=qwen/qwen3.8-flash
QWEN_EMBEDDING_MODEL=qwen/qwen3-embedding-8b

# DashScope alternative: uncomment these lines and remove the OpenRouter ones.
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_LLM_MODEL=qwen3.8-flash
# QWEN_VISION_MODEL=qwen3.8-flash
# QWEN_EMBEDDING_MODEL=text-embedding-v4

QWEN_ENABLE_THINKING=false
EMBEDDING_DIM=1024

# Local embedded Qdrant by default. For a server:
# QDRANT_URL=http://127.0.0.1:6333
QDRANT_PATH=data/qdrant
QDRANT_URL=
QDRANT_API_KEY=
COLLECTION_PREFIX=bars_kb

# Local folder source. GitHub is optional; see GITHUB_*.
DOCS_PATH=docs/source
DATA_DIR=data
IMAGES_DIR=data/images

# Handoff package selection. Point at the dist/ folder: clients follow
# dist/LATEST, so the build id never has to be hardcoded.
# KB_EXPORT_DIR=bars-kb/dist

# GitHub source (optional). Paths are relative to the repository root:
# this project lives in bars-kb/, so docs are bars-kb/docs/source.
GITHUB_REPO=
GITHUB_BRANCH=main
GITHUB_TOKEN=
GITHUB_DOCS_PATH=bars-kb/docs/source
GITHUB_SYNC_INTERVAL_MINUTES=15

# Public base for image URLs. Leave empty to hand over relative paths.
IMAGE_BASE_URL=

# Chunking
CHUNK_MAX_CHARS=1400
CHUNK_OVERLAP_CHARS=180
PARENT_MAX_CHARS=6000

# Parallel LLM/VLM enrichment. Keep conservative to respect API rate limits.
ENRICHMENT_WORKERS=4

# Logging: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
