# ---------------------------------------------------------------------------
# BARS KB — configuration
# Copy to .env and fill keys when they are available.
# The pipeline works without keys in mock mode.
# ---------------------------------------------------------------------------

# mock | deepseek
LLM_PROVIDER=mock
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# mock | qwen
VISION_PROVIDER=mock
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_VISION_MODEL=qwen3-vl-plus

# hash | qwen   (final build uses qwen: text-embedding-v4, dim 1024)
EMBEDDING_PROVIDER=hash
QWEN_EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024

# Local embedded Qdrant by default. For a server:
# QDRANT_URL=http://127.0.0.1:6333
QDRANT_PATH=data/qdrant
QDRANT_URL=
QDRANT_API_KEY=
COLLECTION_PREFIX=bars_kb

# Local folder source. GitHub is optional; see GITHUB_*.
DOCS_PATH=docs/source
DATA_DIR=data
IMAGES_DIR=data/images

# GitHub source (optional)
GITHUB_REPO=
GITHUB_BRANCH=main
GITHUB_TOKEN=
GITHUB_DOCS_PATH=docs
GITHUB_SYNC_INTERVAL_MINUTES=15

# Public base for image URLs. Leave empty to hand over relative paths.
IMAGE_BASE_URL=

# Chunking
CHUNK_MAX_CHARS=1400
CHUNK_OVERLAP_CHARS=180
PARENT_MAX_CHARS=6000
