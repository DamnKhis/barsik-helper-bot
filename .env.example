# ============ Скопируйте в .env и заполните ============
# cp .env.example .env

# --- Telegram-бот ---
BOT_TOKEN=123456789:AAAA-your-botfather-token
# Юзернейм бота без @ — нужен для deep-link на страницы PDF
BOT_USERNAME=your_bot_username
# Кого показывать как оператора поддержки в сообщении «запрос в обработке»
# (пусто — просто сообщение об ожидании, без упоминаний)
SUPPORT_HANDLE=
# Доп. слова вызова оператора через запятую (корни слов); пусто = встроенный список
# OPERATOR_KEYWORDS=оператор,человек,подскаж
# ID администраторов через запятую: им сразу выдаётся роль admin
ADMIN_IDS=123456789

# --- База данных бота (users / dialog_history) ---
# SQLite по умолчанию, можно заменить на PostgreSQL:
# postgresql+asyncpg://user:password@host:5432/bars
DATABASE_URL=sqlite+aiosqlite:///./data/bars.db
# Схема Postgres, которую создаёт приложение (нужно право CREATE на базу).
POSTGRES_SCHEMA=barsik

# --- Дашборд аналитики (/dashboard, /stats) ---
# HTTP Basic. Пустой пароль = страница открыта всем.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

# --- Redis: контекст диалога для ИИ ---
REDIS_URL=redis://localhost:6379/0

# --- Документы, которые загружает администратор ---
# Локальная копия; в KB также попадает bars-kb/docs/source (KB_AUTOSYNC_SOURCE)
UPLOADED_DOCS_DIR=uploaded_docs

# --- Кеш локальной embedding-модели (не качать 250 МБ при каждом запуске) ---
FASTEMBED_CACHE_PATH=data/fastembed_cache
# 1 — вообще не ходить в HuggingFace, если модель уже в кеше (ставится автоматом)
FASTEMBED_LOCAL_ONLY=1

# --- RAG-настройки ---
TOP_K=5
# Ниже порога уверенности бот предлагает оператора. Калибровать на qa/test_cases.csv
CONFIDENCE_THRESHOLD=0.45
# Готовый пакет bars-kb. Указывайте папку dist, а не dist/<build_id>:
# клиент сам читает dist/LATEST и переживает пересборки.
KB_EXPORT_DIR=bars-kb/dist
# Автообновление bars-kb/dist при изменении bars-kb/docs/source.
# Watcher стартует вместе с API/ботом; выключить: KB_AUTOSYNC=0
KB_AUTOSYNC=1
KB_AUTOSYNC_INTERVAL=60
# KB_AUTOSYNC_SOURCE=bars-kb/docs/source
# Второй источник — решённые обращения поддержки. Меняется вместе с документацией:
# watcher следит за обеими папками, чанки помечаются doc_kind=support.
# KB_AUTOSYNC_SUPPORT=bars-kb/docs/support_answers
SUPPORT_DOCS_PATH=docs/support_answers
# Что из тикета попадает в поиск:
#   dialogs — пары «Вопрос/Ответ поддержки», иначе диалог с ответом поддержки (по умолчанию)
#   qa      — строго пары «Вопрос/Ответ поддержки»
#   answers — только ответы поддержки
#   all     — весь файл (для отладки)
# Шумная «История диалога с ИИ» и реплики без ответа в индекс не попадают.
SUPPORT_INDEX_MODE=dialogs
# Сколько ждать, пока загруженный админом документ появится в сборке:
# бот сам сообщит «✅ документ в базе» или «⚠️ пересборка не прошла».
KB_CONFIRM_TIMEOUT_SEC=900

# --- Вопросы со скриншотами ---
# Пользователь может прислать фото/скриншот (с подписью или без). Картинка
# описывается той же vision-моделью и тем же промптом, что и скриншоты при
# сборке базы знаний, и превращается в обычный текстовый запрос — см.
# docs/image-queries.md. Ключ берётся из LLM_API_KEY/QWEN_API_KEY выше.
VISION_ENABLED=1
# QWEN_VISION_MODEL=qwen/qwen3.8-flash   # по умолчанию как у сборки БЗ
# VISION_MODEL=                          # отдельный override, если нужно
VISION_CACHE_DIR=data/vision_cache
# Куда складывать присланные картинки: они нужны оператору в тикете.
IMAGE_QUERY_DIR=data/query_images
IMAGE_MAX_MB=20
# Сколько дней хранить присланные картинки (0 — вечно)
IMAGE_QUERY_KEEP_DAYS=30
# Отдавать ли скриншоты из базы знаний вместе с ответом
SEND_KB_IMAGES=0

# --- Jira: поддержка живёт в задачах Jira ---
# Без BASE_URL и токена бот работает без Jira, а кнопка оператора сообщит об этом.
JIRA_BASE_URL=https://company.atlassian.net
# Для Jira Cloud: email аккаунта-бота. Для Server/PAT можно оставить пустым -> Bearer.
JIRA_EMAIL=bot@company.ru
# Токен API. Алиасы: JIRO_API_KEY и JIRO_API_TOKEN тоже подходят.
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=SUPPORT
JIRA_ISSUE_TYPE=Task
# Как часто опрашивать Jira (мин. 1 сек): ответы поддержки и закрытие задачи
JIRA_POLL_INTERVAL_SEC=1
JIRA_SYNC=1

# --- Полезные ответы поддержки из Jira ---
# Тикет со статусом «Полезно»/useful выгружается в этот каталог как Markdown
SUPPORT_ANSWERS_DIR=bars-kb/docs/support_answers

# --- Git-интеграция: автообновление базы знаний ---
# Пусто = выключено. Пример: https://github.com/team/bars-knowledge-base
DOCS_REPO_URL=
DOCS_REPO_BRANCH=main
DOCS_REPO_TOKEN=
DOCS_POLL_INTERVAL_SEC=60
# Секреты вебхуков (Settings -> Webhooks в GitHub / GitLab)
GITHUB_WEBHOOK_SECRET=
GITLAB_WEBHOOK_SECRET=
