# ============ Скопируйте в .env и заполните ============
# cp .env.example .env

# --- Telegram-бот (роль 3) ---
BOT_TOKEN=123456789:AAAA-your-botfather-token
# ID чата дежурной смены для эскалации (добавьте бота администратором в этот чат)
OPERATOR_CHAT_ID=-1001234567890
# Адрес RAG-ядра с точки зрения бота (в docker-compose — http://api:8000)
API_URL=http://localhost:8000

# --- LLM: любой OpenAI-совместимый провайдер ---
# DeepSeek:  https://api.deepseek.com          (модель deepseek-chat)
# GLM (Z.ai): https://api.z.ai/api/paas/v4     (модель glm-4.6 / glm-4.5)
# OpenAI:    https://api.openai.com/v1
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-...
LLM_MODEL=deepseek-chat

# --- Эмбеддинги (могут быть от другого провайдера) ---
# Пустые значения = берутся из LLM_BASE_URL / LLM_API_KEY.
# Для русского языка хорош локальный bge-m3 через Ollama:
#   EMBEDDING_BASE_URL=http://localhost:11434/v1
#   EMBEDDING_MODEL=bge-m3
#   EMBEDDING_DIM=1024
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# --- VLM: подписи скриншотов из PDF (пусто = плейсхолдер без подписи) ---
# Использует LLM_BASE_URL / LLM_API_KEY; модель должна уметь картинки.
# Пример: VLM_MODEL=glm-4v при LLM_BASE_URL=https://api.z.ai/api/paas/v4
VLM_MODEL=

# --- Хранилища (в docker-compose переопределяются именами сервисов) ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=bars_docs
REDIS_URL=redis://localhost:6379/0

# --- RAG-настройки ---
TOP_K=5
# Ниже порога уверенности бот предлагает оператора. Калибровать на qa/test_cases.csv
CONFIDENCE_THRESHOLD=0.45

# --- Git-интеграция: автообновление базы знаний ---
# Пусто = выключено. Пример: https://github.com/team/bars-knowledge-base
DOCS_REPO_URL=
DOCS_REPO_BRANCH=main
DOCS_REPO_TOKEN=
DOCS_POLL_INTERVAL_SEC=60
# Секреты вебхуков (Settings -> Webhooks в GitHub / GitLab)
GITHUB_WEBHOOK_SECRET=
GITLAB_WEBHOOK_SECRET=
