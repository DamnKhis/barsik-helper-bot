# ============ Скопируйте в .env и заполните ============
# cp .env.example .env

# --- Telegram-бот ---
BOT_TOKEN=123456789:AAAA-your-botfather-token
# ID администраторов через запятую: им сразу выдаётся роль admin
ADMIN_IDS=123456789

# --- База данных бота (users / dialog_history) ---
# SQLite по умолчанию, можно заменить на PostgreSQL:
# postgresql+asyncpg://user:password@host:5432/bars
DATABASE_URL=sqlite+aiosqlite:///./data/bars.db
# Схема Postgres, которую создаёт приложение (нужно право CREATE на базу).
POSTGRES_SCHEMA=barsik

# --- Дашборд аналитики (/dashboard, /stats) ---
# HTTP Basic. Пустой пароль = страница открыта всем.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

# --- Redis: контекст диалога для ИИ ---
REDIS_URL=redis://localhost:6379/0

# --- Документы, которые загружает администратор ---
# Локальная копия; в KB также попадает bars-kb/docs/source (KB_AUTOSYNC_SOURCE)
UPLOADED_DOCS_DIR=uploaded_docs

# --- Кеш локальной embedding-модели (не качать 250 МБ при каждом запуске) ---
FASTEMBED_CACHE_PATH=data/fastembed_cache
# 1 — вообще не ходить в HuggingFace, если модель уже в кеше (ставится автоматом)
FASTEMBED_LOCAL_ONLY=1

# --- RAG-настройки ---
TOP_K=5
# Ниже порога уверенности бот предлагает оператора. Калибровать на qa/test_cases.csv
CONFIDENCE_THRESHOLD=0.45
# Готовый пакет bars-kb. Указывайте папку dist, а не dist/<build_id>:
# клиент сам читает dist/LATEST и переживает пересборки.
KB_EXPORT_DIR=bars-kb/dist
# Автообновление bars-kb/dist при изменении bars-kb/docs/source.
# Watcher стартует вместе с API/ботом; выключить: KB_AUTOSYNC=0
KB_AUTOSYNC=1
KB_AUTOSYNC_INTERVAL=60
# KB_AUTOSYNC_SOURCE=bars-kb/docs/source

# --- Git-интеграция: автообновление базы знаний ---
# Пусто = выключено. Пример: https://github.com/team/bars-knowledge-base
DOCS_REPO_URL=
DOCS_REPO_BRANCH=main
DOCS_REPO_TOKEN=
DOCS_POLL_INTERVAL_SEC=60
# Секреты вебхуков (Settings -> Webhooks в GitHub / GitLab)
GITHUB_WEBHOOK_SECRET=
GITLAB_WEBHOOK_SECRET=
